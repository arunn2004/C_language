1] Arithmetic Operators
The arithmetic operators are used to perform arithmetic/mathematical operations on operands. There are 9 arithmetic operators in C language:

#include <stdio.h>
​
int main() {
​
    int a = 25, b = 5;
​
    // using operators and printing results
    printf("a + b = %d\n", a + b);
    printf("a - b = %d\n", a - b);
    printf("a * b = %d\n", a * b);
    printf("a / b = %d\n", a / b);
    printf("a %% b = %d\n", a % b);
    printf("+a = %d\n", +a);
    printf("-a = %d\n", -a);
    printf("a++ = %d\n", a++);
    printf("a-- = %d\n", a--);
​
    return 0;
}

Output
a + b = 30
a - b = 20
a * b = 125
a / b = 5
a % b = 0 [ modulus , gives only remainder value after the division ] . 
+a = 25
-a = -25


a++ :  x++ is called post-increment because the increment happens after the value is used.
#include <stdio.h>

int main() {
    int a = 5; //  Initialize the variable a with the value 5

    printf("Before: %d\n", a);   // Print current value
    printf("a++: %d\n", a++);    // Use, then increment
    printf("After: %d\n", a);    // Value after increment

    return 0;
}
Expected Output:
Before: 5
a++: 5
After: 6

++a :  the pre-increment operator (++x) increases the value of a variable by 1, but before its current value is used
#include <stdio.h>

int main() {
    int x = 7;  // Initialize x with 7

    // Pre-increment: x is incremented first, then printed
    printf("Value after pre-increment: %d\n", ++x);

    return 0;
}
Expected output:

Value after pre-increment: 8

same as for pre and post decrement
